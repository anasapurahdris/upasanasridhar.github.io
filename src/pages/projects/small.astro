---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = { title: 'SMaLL — Project', description: 'SMaLL: reusable high-performance ML libraries.' };
---
<BaseLayout title={meta.title} description={meta.description}>
  <section class="container section">
    <div class="section-header">
      <p class="eyebrow">Project</p>
      <h1 class="section-heading">SMaLL</h1>
    </div>

    <article class="project-article">
      <h2>The question</h2>
      <p>How much of the work involved in building efficient software can be reused rather than rediscovered for every operator, model, or architecture?</p>

      <h2>What I built</h2>
      <p>A framework that composes reusable microkernels and orchestration abstractions to instantiate architecture-specialized ML libraries. (Placeholder description.)</p>

      <h2>Why it mattered</h2>
      <p>The project demonstrates how careful interface and orchestration design can preserve performance while enabling reuse across models and hardware.</p>

      <h2>Artifacts</h2>
      <p class="project-links"><a class="meta-link" href="#">Paper (placeholder)</a> <a class="meta-link" href="#">Code (placeholder)</a></p>
    </article>
  </section>
</BaseLayout>
