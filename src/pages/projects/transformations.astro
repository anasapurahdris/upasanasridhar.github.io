---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = { title: 'Performance transformations — Project', description: 'Organizing performance transformations into reusable knowledge.' };
---
<BaseLayout title={meta.title} description={meta.description}>
  <section class="container section">
    <div class="section-header">
      <p class="eyebrow">Project</p>
      <h1 class="section-heading">Making performance transformations explicit</h1>
    </div>

    <article class="project-article">
      <h2>The question</h2>
      <p>Can optimization folklore be organized into a set of transformations, constraints, and patterns that are reusable and inspectable?</p>

      <h2>What I built</h2>
      <p>Documentation and tooling concepts to capture transformations and their dependencies so they can be applied in a controlled and explainable way.</p>

      <h2>Artifacts</h2>
      <p class="project-links"><a class="meta-link" href="#">Notes (placeholder)</a></p>
    </article>
  </section>
</BaseLayout>
