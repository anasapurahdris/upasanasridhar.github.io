---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = { title: 'Formal methods for HPC — Project', description: 'Verified transformations and correct-by-construction implementations.' };
---
<BaseLayout title={meta.title} description={meta.description}>
  <section class="container section">
    <div class="section-header">
      <p class="eyebrow">Project</p>
      <h1 class="section-heading">Formal methods for high-performance code</h1>
    </div>

    <article class="project-article">
      <h2>The question</h2>
      <p>Can we preserve a precise description of what a program computes while systematically changing its mapping to hardware?</p>

      <h2>What I built</h2>
      <p>Work that applies formal descriptions to generate provably correct low-level implementations for tensor transforms and related patterns.</p>

      <h2>Artifacts</h2>
      <p class="project-links"><a class="meta-link" href="#">Notes (placeholder)</a></p>
    </article>
  </section>
</BaseLayout>
