---
import BaseLayout from '../../layouts/BaseLayout.astro';

const meta = { title: 'Composable ML operators — Project', description: 'Designing operators that remain efficient in context.' };
---
<BaseLayout title={meta.title} description={meta.description}>
  <section class="container section">
    <div class="section-header">
      <p class="eyebrow">Project</p>
      <h1 class="section-heading">Composable ML operators</h1>
    </div>

    <article class="project-article">
      <h2>The question</h2>
      <p>When do independently efficient implementations compose without destroying overall performance?</p>

      <h2>What I built</h2>
      <p>Analysis and prototypes that explore operator composition, microkernel interfaces, and context-sensitive performance trade-offs.</p>

      <h2>Artifacts</h2>
      <p class="project-links"><a class="meta-link" href="#">Notes (placeholder)</a> <a class="meta-link" href="#">Demo (placeholder)</a></p>
    </article>
  </section>
</BaseLayout>
