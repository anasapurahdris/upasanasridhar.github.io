        <li><a href={sitePath('/teaching')}>Teaching</a></li>
        <li><a href={sitePath('/writing')}>Writing</a></li>
        <li><a href={sitePath('/CV_Upasana_Spring26%20(17).pdf')}>CV</a></li>
      </ul>
    </nav>
